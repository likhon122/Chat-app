# ==========================================
# Server Configuration
# ==========================================
PORT=3000

# ==========================================
# Frontend URLs (CORS & Redirection / Verification)
# ==========================================
FRONTEND_URL1=http://localhost:5173
FRONTEND_URL2=http://localhost:3000
FRONTEND_URL3=http://localhost:5173

# ==========================================
# Database Configuration (MongoDB)
# ==========================================
MONGODB_URL=mongodb://localhost:27017/chat-app

# ==========================================
# JWT Secret Keys
# ==========================================
JSON_WEB_TOKEN_KEY=your_jwt_account_activation_secret_key
ACCESS_TOKEN_KEY=your_access_token_secret_key
REFRESH_TOKEN_KEY=your_refresh_token_secret_key
RESET_PASSWORD_KEY=your_reset_password_secret_key

# ==========================================
# SMTP / Email Configuration (Nodemailer)
# ==========================================
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# ==========================================
# Web Push Notification (VAPID Keys)
# ==========================================
PUBLIC_VAPID_KEY=your_public_vapid_key
PRIVATE_VAPID_KEY=your_private_vapid_key

# ==========================================
# Admin Panel Credentials & Route
# ==========================================
ADMIN_LOGIN_PATH=admin
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=your_admin_secure_password

# ==========================================
# Cloudinary Configuration
# ==========================================
CLOUDINARY_CLOUDE_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

