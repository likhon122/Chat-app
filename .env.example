# ==============================================================================
# Chat Application - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or 'backend/.env' and update the values with your credentials.

# ------------------------------------------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=7777
NODE_ENV=production

# ------------------------------------------------------------------------------
# MongoDB Database
# ------------------------------------------------------------------------------
# When using Docker Compose, use the service name 'mongo':
MONGODB_URL=mongodb://mongo:27017/chat_app
# For local standalone development without Docker, use:
# MONGODB_URL=mongodb://localhost:27017/chat_app

# ------------------------------------------------------------------------------
# Allowed Frontend Origins (CORS & Cookie Transmission)
# ------------------------------------------------------------------------------
FRONTEND_URL1=http://localhost
FRONTEND_URL2=http://localhost:5173
FRONTEND_URL3=http://localhost:80

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Generate strong 256-bit keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JSON_WEB_TOKEN_KEY=your_super_secret_jwt_key_min_32_characters_long
ACCESS_TOKEN_KEY=your_access_token_secret_key_minimum_32_characters
REFRESH_TOKEN_KEY=your_refresh_token_secret_key_minimum_32_characters
RESET_PASSWORD_KEY=your_reset_password_token_secret_key_minimum_32_chars

# ------------------------------------------------------------------------------
# Cloudinary (Media, Avatars & Attachment Storage)
# ------------------------------------------------------------------------------
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUDE_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Nodemailer (Transactional Email & Account Verification)
# ------------------------------------------------------------------------------
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# Web Push Notifications (VAPID Keys)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=your_public_vapid_key
PRIVATE_VAPID_KEY=your_private_vapid_key

# ------------------------------------------------------------------------------
# Administration Portal
# ------------------------------------------------------------------------------
ADMIN_LOGIN_PATH=/admin-secret-access
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=StrongAdminPassword123!
